{# Homepage (HANDOFF §4.1, reference-html/home.html + mobile-home.html). STATIC FRONT-END: each <section> maps to a future page-builder block. #}
{% extends 'layouts/site.html.twig' %}

{% block title %}{{ 'site.tagline'|trans }}{{ setting('seo.title_suffix') }}{% endblock %}

{% block content %}
{%- set max = setting('booking.max_group_size') -%}
{%- set price = 'common.price_placeholder'|trans -%}

{# ---- Hero + slider ---- #}
<section id="top" class="flex flex-col items-center gap-5 lg:gap-9 px-gutter-m lg:px-gutter pt-12 lg:pt-[88px] text-center">
    <twig:Ui:Label>{{ 'home.hero.label'|trans({'%city%': setting('studio.city')}) }}</twig:Ui:Label>
    <h1 class="m-0 max-w-[880px] font-display text-display-xl-m lg:text-display-xl leading-none">{{ 'site.tagline'|trans }}</h1>
    <p class="m-0 max-w-[620px] text-body lg:text-lead text-ink-soft">{{ 'home.hero.intro'|trans({'%max%': max}) }}</p>
    <div class="flex w-full flex-col items-center justify-center gap-1 lg:w-auto lg:flex-row lg:gap-3.5">
        <twig:Ui:Button size="lg" href="{{ path('intake_new') }}" class="w-full lg:w-auto">{{ 'common.cta_plan_yours'|trans }}</twig:Ui:Button>
        <twig:Ui:Button variant="outline" size="lg" href="#trainen" class="max-lg:border-0 max-lg:border-b max-lg:px-3 max-lg:py-3 max-lg:text-ui">{{ 'home.hero.cta_secondary'|trans }}</twig:Ui:Button>
    </div>
    <twig:Site:Slider
        class="self-stretch pt-3 lg:pt-6"
        caption="{{ 'home.slider.caption'|trans }}"
        :slides="['home.slider.slide1'|trans, 'home.slider.slide2'|trans, 'home.slider.slide3'|trans]"
    />
</section>

{# ---- Story ---- #}
<section id="verhaal" class="mx-gutter-m lg:mx-0 mt-14 lg:mt-24 grid items-start gap-[18px] lg:grid-cols-2 lg:gap-16 border-t border-line pt-10 lg:px-gutter lg:pt-32 lg:pb-24">
    <h2 class="m-0 font-display text-display-lg-m lg:text-display-lg leading-[1.05]">{{ 'home.story.heading_1'|trans }}<br>{{ 'home.story.heading_2'|trans }}</h2>
    <div class="flex flex-col gap-[18px] lg:gap-7 text-base lg:text-[18px] leading-[1.65] text-ink-soft">
        <p class="m-0">{{ 'home.story.p1'|trans }}</p>
        <p class="m-0">{{ 'home.story.p2'|trans }}</p>
        <a href="{{ path('marketing_about') }}" class="text-[13px] lg:text-ui font-semibold uppercase tracking-[0.08em] text-accent">{{ 'home.story.link'|trans }} →</a>
    </div>
</section>

{# ---- Offer ---- #}
<section id="trainen" class="mx-gutter-m lg:mx-gutter mt-12 lg:mt-0 hairline-grid lg:grid-cols-3">
    {% for offer in [
        {photo: 'home.offer.group.photo'|trans, title: 'home.offer.group.title'|trans, text: 'home.offer.group.text'|trans({'%max%': max}), price: 'home.offer.group.price'|trans({'%price%': price}), mobilePhoto: true},
        {photo: 'home.offer.one.photo'|trans, title: 'home.offer.one.title'|trans, text: 'home.offer.one.text'|trans, price: 'home.offer.one.price'|trans({'%price%': price}), mobilePhoto: true},
        {photo: 'home.offer.fixed.photo'|trans, title: 'home.offer.fixed.title'|trans, text: 'home.offer.fixed.text'|trans({'%hours%': setting('booking.cancel_window_hours')}), price: 'home.offer.fixed.price'|trans, mobilePhoto: false},
    ] %}
        <article class="hairline-cell flex flex-col gap-3 lg:gap-[18px] p-5 lg:p-8">
            <twig:Ui:ImagePlaceholder label="{{ offer.photo }}" class="h-40 lg:h-[220px] {{ offer.mobilePhoto ? '' : 'max-lg:hidden' }}" />
            <h3 class="m-0 font-display text-[30px] lg:text-display-sm">{{ offer.title }}</h3>
            <p class="m-0 text-ui lg:text-base leading-[1.6] text-ink-soft">{{ offer.text }}</p>
            <span class="text-small lg:text-base font-semibold text-accent">{{ offer.price }}</span>
        </article>
    {% endfor %}
</section>

{# ---- Trainers ---- #}
<section id="team" class="mt-14 lg:mt-28 flex flex-col gap-5 lg:gap-10 bg-deep px-gutter-m lg:px-gutter py-12 lg:py-24">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between lg:gap-6">
        <h2 class="m-0 font-display text-display-lg-m lg:text-display-lg leading-[1.05]">{{ 'home.trainers.heading'|trans }}</h2>
        <p class="m-0 max-w-[420px] text-ui lg:text-base leading-[1.6] text-ink-soft">{{ 'home.trainers.intro'|trans }}</p>
    </div>
    <div class="-mx-gutter-m flex gap-2.5 overflow-x-auto [scrollbar-width:none] px-gutter-m pb-1 lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-3 lg:overflow-visible lg:px-0 lg:pb-0">
        {% for i in 1..3 %}
            <article class="flex shrink-0 basis-60 flex-col gap-2 lg:gap-3">
                <twig:Ui:ImagePlaceholder label="{{ 'trainers.portrait'|trans({'%n%': i}) }}" class="h-[300px] lg:h-[380px]" />
                <strong class="lg:text-xl">{{ 'trainers.name_placeholder'|trans }}</strong>
                <span class="text-[13px] lg:text-base text-ink-mute">{{ ('trainers.t' ~ i ~ '.spec')|trans }}<span class="max-lg:hidden"> · {{ ('trainers.t' ~ i ~ '.days')|trans }}</span></span>
            </article>
        {% endfor %}
    </div>
</section>

{# ---- Testimonial ---- #}
<section id="ervaringen" class="flex flex-col items-center gap-5 lg:gap-8 px-gutter-m lg:px-gutter py-16 lg:py-28 text-center">
    <twig:Ui:Label>{{ 'home.testimonials.label'|trans }}</twig:Ui:Label>
    {# TODO: real testimonials come from the admin (Testimonial entity). Never invent quotes. #}
    <blockquote class="m-0 max-w-[900px] font-display font-medium text-[28px] leading-[1.3] lg:text-quote">„{{ 'home.testimonials.quote_placeholder'|trans }}”</blockquote>
    <span class="text-small lg:text-base text-ink-mute">{{ 'home.testimonials.author_placeholder'|trans }}</span>
    <twig:Ui:Indicator class="max-lg:hidden" />
</section>

{# ---- Framed CTA ---- #}
<twig:Site:CtaFrame heading="{{ 'brand.coffee'|trans }}" text="{{ 'home.cta.text'|trans }}" />
{% endblock %}
