{# Site:Slider — horizontal scroll-snap strip of cards with a Cormorant caption, dash indicator and square 44px prev/next buttons.
   Swipe + buttons + arrow keys. Full-bleed on mobile (parent section supplies the gutter on desktop). #}
{% props slides = [], caption = '', firstBasis = 'md:basis-[60%]', height = 'h-[380px] md:h-[520px]', autoplay = 0 %}
<div data-controller="slider" data-slider-autoplay-value="{{ autoplay }}" {{ attributes.defaults({class: 'flex flex-col gap-3 md:gap-4 -mx-gutter-m md:mx-0'}) }}>
    <div data-slider-target="track" data-action="keydown.left->slider#prev keydown.right->slider#next" tabindex="0" role="group" aria-roledescription="carousel" aria-label="{{ caption }}" class="relative flex gap-2.5 md:gap-3 overflow-x-auto snap-x snap-mandatory scroll-pl-gutter-m md:scroll-pl-0 px-gutter-m md:px-0 pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {% for slide in slides %}
            <twig:Ui:ImagePlaceholder label="{{ slide }}" data-slider-target="slide" class="snap-start shrink-0 basis-[300px] md:min-w-[280px] {{ loop.first ? firstBasis : 'md:basis-[40%]' }} {{ height }}" />
        {% endfor %}
    </div>
    <div class="flex items-center justify-between gap-3 md:gap-4 px-gutter-m md:px-0">
        <p class="m-0 font-display font-medium text-[19px] md:text-2xl text-ink-soft text-left">{{ caption }}</p>
        <div class="flex shrink-0 items-center gap-2">
            <twig:Ui:Indicator count="{{ slides|length }}" target="slider" />
            <button type="button" aria-label="{{ 'common.prev'|trans }}" data-action="slider#prev" class="hidden md:inline-flex ml-3 size-touch items-center justify-center border border-control bg-transparent text-ink cursor-pointer transition-colors hover:border-accent hover:text-accent">
                <twig:Ui:Icon name="chevron-left" size="18" />
            </button>
            <button type="button" aria-label="{{ 'common.next'|trans }}" data-action="slider#next" class="hidden md:inline-flex size-touch items-center justify-center border border-control bg-transparent text-ink cursor-pointer transition-colors hover:border-accent hover:text-accent">
                <twig:Ui:Icon name="chevron-right" size="18" />
            </button>
        </div>
    </div>
</div>
