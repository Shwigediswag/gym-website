{# Ui:Avatar — the only round shape in the design. Stack with -ml-2 on siblings. #}
{% props initials = '', size = 'md', tone = 'default' %}
{%- set sizes = {sm: 'size-8 text-[11px]', md: 'size-[34px] text-[11px]', lg: 'size-[46px] text-[13px]'} -%}
<span {{ attributes.defaults({class: 'avatar shrink-0 ' ~ sizes[size] ~ (tone == 'strong' ? ' bg-control' : '')}) }}>{{ initials }}</span>
